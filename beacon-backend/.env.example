# ─── DATABASE (required) ────────────────────────────────────────────
# PostgreSQL connection string. If your password contains @ it must be
# URL-encoded as %40 (e.g. p@ss -> p%40ss).
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/manzil

# ─── JWT (required) ─────────────────────────────────────────────────
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ─── EMAIL ENCRYPTION (required) ────────────────────────────────────
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: if you change this key later, previously stored email
# addresses can no longer be decrypted. Keep it safe.
EMAIL_ENCRYPTION_KEY=

# ─── ENVIRONMENT ────────────────────────────────────────────────────
# "development" locally. Set to "production" on a live server -
# in production the app refuses to start without EMAIL_ENCRYPTION_KEY.
ENVIRONMENT=development

# ─── AI (required for Chat + Expert System) ─────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── CORS (optional) ────────────────────────────────────────────────
# Comma-separated extra origins allowed to call this API, e.g. your
# deployed frontend URL. localhost + *.vercel.app are allowed by default.
# ALLOWED_ORIGINS=https://your-frontend.example.com
